module register_file (

 input wire clk,

 input wire we,

 input wire [4:0] rs1, 

 input wire [4:0] rs2, 

 input wire [4:0] rd,

 input wire [31:0] wd, 
 
 output wire [31:0] rd1, 

 output wire [31:0] rd2

);

 reg [31:0] registers [31:0];

 assign rd1 = registers [rs1];

 assign rd2 = registers [rs2];

  always @(posedge clk) begin
  if (we==1 && rd=5'b0)
  registers [rd] <= wd;
 end

initial begin
registers[0]=32'd0;
registers[1]=32'd10;
registers[2]=32'd4;
end  
endmodule
